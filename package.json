{
  "name": "video-cropper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "ci": "biome ci ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses:frontend": "pnpm licenses list --prod --json | jq \"del(.[].[].paths)\" > licenses/frontend-licenses.json",
    "licenses:rust": "cd src-tauri && cargo about generate about.hbs -o ../licenses/rust-licenses.html",
    "licenses:generate": "pnpm licenses:frontend && pnpm licenses:rust",
    "licenses:rust:deny": "cd src-tauri && cargo deny check licenses"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-log": "~2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
